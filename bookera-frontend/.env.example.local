# =============================================================
# BookEra — змінні оточення (фронтенд)
#
# Скопіюйте у `.env.local`:
#     cp .env.example.local .env.local
#
# Префікс NEXT_PUBLIC_ означає, що значення потрапляє в код,
# який виконується в браузері. Тобто його побачить будь-хто.
# Ніколи не кладіть сюди секретні ключі — лише ті, що й так
# публічні за призначенням.
# =============================================================

# Адреса проєкту Supabase: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://ВАШ_ПРОЄКТ.supabase.co

# Публічний ключ: Project Settings → API → anon / public
#
# Він справді призначений бути на видноті: доступ до даних
# обмежує не ключ, а політики RLS у самій базі.
#
# НЕ плутайте з service_role — той дає повний доступ в обхід
# усіх політик і в браузері не має бути НІКОЛИ.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Адреса бекенду. Локально — той порт, на якому запущено uvicorn.
# У продакшні — адреса вашого API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
