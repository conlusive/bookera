# =============================================================
# BookEra — змінні оточення (бекенд)
#
# Скопіюйте цей файл у `.env` і заповніть значення:
#     cp .env.example .env
#
# Порядок такий: спершу ОБОВʼЯЗКОВІ — без них застосунок не
# підніметься. Далі ті, без яких він працює, але частина
# можливостей мовчить.
# =============================================================


# --- ОБОВʼЯЗКОВІ ---------------------------------------------

# Підключення до бази. Береться в Supabase: Project Settings →
# Database → Connection string → URI, режим "Transaction pooler".
#
# Саме pooler, а не пряме підключення: у безсерверному середовищі
# кожен запит відкриває нове зʼєднання, і база швидко впирається
# в ліміт.
#
# Зверніть увагу на префікс postgresql+asyncpg:// — драйвер
# асинхронний, зі звичайним postgresql:// застосунок не стартує.
DATABASE_URL=postgresql+asyncpg://postgres.ВАШ_ПРОЄКТ:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Адреса проєкту Supabase: Project Settings → API → Project URL
SUPABASE_URL=https://ВАШ_ПРОЄКТ.supabase.co

# Хто має право звертатись до API. У продакшні — адреса вашого
# сайту. Кілька адрес через кому.
#
# Не ставте сюди *: це відкриє API будь-якому сайту, і чужа
# сторінка зможе робити запити від імені залогіненого власника.
ALLOWED_ORIGINS=http://localhost:3000

# Адреса фронтенду. Використовується в листах — посилання
# «Переглянути запис» веде саме сюди.
FRONTEND_URL=http://localhost:3000


# --- ПОШТА ---------------------------------------------------
#
# Без цих ключів застосунок працює, але ЖОДЕН лист не надсилається:
# ні підтвердження запису, ні перенесення, ні розсилка. У логах
# зʼявляється "[Email Mock] До: ..." замість реальної відправки.
#
# ЯК ОТРИМАТИ ДЛЯ GMAIL (5 хвилин):
#   1. Увімкніть двоетапну перевірку:
#      Google Account → Security → 2-Step Verification
#      Без неї пункт нижче просто не зʼявиться.
#   2. Створіть пароль застосунку:
#      https://myaccount.google.com/apppasswords
#      Виберіть "Mail" → "Other" → назвіть "BookEra"
#   3. Google покаже 16 символів на кшталт "abcd efgh ijkl mnop".
#      Вставте їх у SMTP_PASSWORD БЕЗ пробілів.
#
# Це НЕ пароль від пошти. Звичайний пароль Google для SMTP не
# приймає, і саме тому потрібен окремий пароль застосунку.
#
# ВАЖЛИВО ДЛЯ ПРОДАКШНУ: Gmail обмежує ~500 листів на добу й може
# позначити масову розсилку як спам. Для реальної роботи візьміть
# поштовий сервіс (Resend, SendGrid, Mailgun) — там ті самі
# SMTP-налаштування, лише інший хост.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ваша.пошта@gmail.com
SMTP_PASSWORD=шістнадцятьсимволівбезпробілів


# --- ОПЛАТА ПІДПИСКИ -----------------------------------------
#
# Без цих ключів кнопка «Продовжити» НЕ веде на оплату, а
# продовжує підписку одразу — щоб можна було перевірити потік.
# У логах це пишеться як WARNING.
#
# Щойно ключі зʼявляться, поведінка перемкнеться сама: код
# змінювати не треба.
#
# Отримуються після укладення договору з WayForPay:
# https://wayforpay.com → особистий кабінет → Налаштування →
# Реквізити мерчанта.
WFP_MERCHANT_LOGIN=
WFP_MERCHANT_SECRET=
# Домен, зареєстрований у WayForPay. Має збігатися з тим, що
# вказано в договорі, інакше платіж відхилять.
WFP_DOMAIN=bookera.ua

# Ціна підписки за 30 днів, у гривнях.
SUBSCRIPTION_PRICE_UAH=490


# --- НЕОБОВʼЯЗКОВІ -------------------------------------------

# Redis для обмеження частоти запитів. Без нього ліміти рахуються
# в памʼяті процесу — цього досить для одного сервера, але при
# кількох копіях застосунку кожна рахуватиме окремо.
# REDIS_URL=redis://localhost:6379

# Розмір пулу зʼєднань до бази. Чіпати варто лише якщо бачите
# в логах "QueuePool limit reached".
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Застарілий ключ перевірки токенів. Тепер використовується JWKS
# (асиметричні ключі), але лишений як запасний шлях для старих
# токенів, виданих до переходу.
# SUPABASE_JWT_SECRET=
